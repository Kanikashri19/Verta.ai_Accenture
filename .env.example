# ==========================================
# VERTA.AI PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# BACKEND (RENDER) ENVIRONMENT VARIABLES
# ------------------------------------------
# Environment mode
VERTA_ENVIRONMENT=production

# Python Runtime Version
PYTHON_VERSION=3.12.4

# Allowed CORS Origins (Vercel domain or comma-separated list of URLs)
# Example: https://verta-ai-frontend.vercel.app,https://yourcustomdomain.com
# Set to * or leave empty to allow all origins in preview
CORS_ORIGINS=*

# LLM Provider Configuration (mock for zero-cost deterministic demo or gemini/openai/anthropic)
LLM_PROVIDER=mock
LLM_MODEL=mock-llm-v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Optional: Real LLM API keys if switching provider from mock
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ------------------------------------------
# FRONTEND (VERCEL) ENVIRONMENT VARIABLES
# ------------------------------------------
# URL of your Render backend deployment
# Example: https://verta-ai-backend.onrender.com
VITE_API_URL=https://your-backend-app-name.onrender.com
