# ========================================================
# Verta.ai Environment Configuration Template
# NOTE: DO NOT COMMIT REAL SECRETS OR API KEYS
# ========================================================

# LLM Gateway Configuration
LLM_PROVIDER=mock                     # Options: "mock", "gemini", "openai", "anthropic", "ollama"
LLM_MODEL=mock-llm-v1                 # e.g., "gemini-1.5-pro", "gpt-4o", "claude-3-5-sonnet-20240620"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Pricing Configuration (USD per 1,000 tokens)
LLM_INPUT_COST_PER_1K=0.00125
LLM_OUTPUT_COST_PER_1K=0.00500

# Optional API Keys (Set only in local .env, NEVER in version control)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# System Settings
VERTA_MOCK_LLM=true                   # Set to false to invoke live external LLM provider
VERTA_ENVIRONMENT=development
